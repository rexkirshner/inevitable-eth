# Environment Variables Example
# Copy this file to .env.local for local development
# DO NOT commit .env.local to version control

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://inevitableeth.com

# GitHub Repository
# Used for "Edit on GitHub" links and footer
NEXT_PUBLIC_GITHUB_REPO=https://github.com/rexkirshner/inevitable-eth

# Giscus Comments (GitHub Discussions-based)
# Get these values from https://giscus.app after enabling GitHub Discussions
NEXT_PUBLIC_GISCUS_REPO=rexkirshner/inevitable-eth
NEXT_PUBLIC_GISCUS_REPO_ID=R_kgDOP7Mg-Q
NEXT_PUBLIC_GISCUS_CATEGORY=General
NEXT_PUBLIC_GISCUS_CATEGORY_ID=DIC_kwDOP7Mg-c4CwR7G

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-9K8VQGCQ5D
